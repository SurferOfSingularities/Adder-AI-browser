<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application>
        <!--
          App Startup entry point. Registering the initializer here means any host app
          that depends on :shared picks up AdderContextInitializer through manifest
          merging, which gives the shared module an application Context for
          SharedPreferences-backed persistence.
        -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="com.adder.shared.AdderContextInitializer"
                android:value="androidx.startup" />
        </provider>
    </application>
</manifest>
